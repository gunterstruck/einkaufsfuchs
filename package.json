{
  "name": "einkaufsfuchs",
  "version": "0.9.0",
  "description": "EinkaufsFuchs (Foxi) – Einkaufsliste für Haushalt, Familie und WG. PWA, alle Daten bleiben auf dem Gerät.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node tools/server.mjs",
    "start": "node tools/server.mjs",
